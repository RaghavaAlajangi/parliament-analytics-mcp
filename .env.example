# ── DIP Bundestag API ─────────────────────────────────────────────────────────
# Free demo key; replace with your own from https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=BTK2024

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: "groq" or "anthropic" or "openai"
LLM_PROVIDER=groq

# Groq (free tier): https://groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# ── LLM Model Settings ───────────────────────────────────────────────────────
LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── Pipeline Settings ────────────────────────────────────────────────────────
MAX_ROUTER_RETRIES=3
# Prevent rate limiting
DIP_PAGE_SIZE=50
DIP_MAX_CONCURRENT=1
DIP_PAGE_DELAY=1.0
DIP_MAX_RECORDS=800

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
