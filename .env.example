# ── DIP Bundestag API ─────────────────────────────────────────────────────────
# Free demo key; replace with your own from https://dip.bundestag.de/über-dip/hilfe/api
DIP_API_KEY=BTK2024

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: "groq" or "anthropic"
LLM_PROVIDER=groq

# Groq (free tier): https://groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Anthropic (optional alternative)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── LLM Model Settings ───────────────────────────────────────────────────────
LLM_MODEL=llama3-70b-8192
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── Pipeline Settings ────────────────────────────────────────────────────────
MAX_ROUTER_RETRIES=3
DIP_PAGE_SIZE=100
DIP_MAX_CONCURRENT=3

# ── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
