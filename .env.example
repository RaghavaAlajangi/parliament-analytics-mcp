# ── DIP Bundestag API ─────────────────────────────────────────────────────────
# Public key (rotates yearly; this one is valid until end of May 2027):
# https://dip.bundestag.de/über-dip/hilfe/api
# For a personal 10-year key, email parlamentsdokumentation@bundestag.de
DIP_API_KEY=R2BZaee.DjdCyihKZMf8AOjtScubP2EVydegzjmBIQ

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: "groq" or "openai"
LLM_PROVIDER=groq

# Groq (free tier): https://groq.com/
GROQ_API_KEY=your_groq_api_key_here

# OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# ── LLM Model Settings ───────────────────────────────────────────────────────
LLM_MODEL=llama-3.3-70b-versatile
# LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# ── Pipeline Settings ────────────────────────────────────────────────────────
MAX_ROUTER_RETRIES=3

# ── DIP rate limiting / bot protection ───────────────────────────────────────
# DIP fronts its API with a bot-protection layer; keep request volume low.
DIP_MAX_CONCURRENT=1
DIP_PAGE_DELAY=1.0
DIP_MAX_RECORDS=5000
DIP_RETRY_ATTEMPTS=4
DIP_RETRY_MIN_WAIT=1.0
DIP_RETRY_MAX_WAIT=30.0
# Cache DIP responses on disk for this many seconds (0 = off)
DIP_CACHE_TTL=3600
DIP_CACHE_DIR=.dip_cache

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
